@{
    ViewData["Title"] = "Send message";
    var options = (List<(string value, string label)>)ViewBag.Audiences;
    var to = ViewBag.To as string;
}
<div class="page-head"><div><h1>Send a communication</h1><p>Messages appear immediately in recipients' portals.</p></div></div>
<div class="card" style="max-width:860px">
    <div class="card-body p-4">
        <form method="post" asp-action="Compose">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">To</label>
                    <select name="audience" class="form-select" required>
                        <option value="">Choose recipients…</option>
                        @foreach (var grp in options.GroupBy(o => o.label.Contains(':') ? o.label.Split(':')[0] : "Groups"))
                        {
                            <optgroup label="@grp.Key">
                                @foreach (var o in grp) { <option value="@o.value" selected="@(o.value == to)">@o.label</option> }
                            </optgroup>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Priority</label>
                    <select name="priority" class="form-select"><option>Normal</option><option>Important</option><option>Urgent</option></select>
                </div>
                <div class="col-12"><label class="form-label">Subject</label><input name="subject" class="form-control" maxlength="150" required /></div>
                <div class="col-12"><label class="form-label">Message</label><textarea name="body" class="form-control" rows="8" required></textarea></div>
                <div class="col-12"><button class="btn btn-primary px-4"><i class="bi bi-send"></i> Send</button></div>
            </div>
        </form>
    </div>
</div>
