@{ ViewData["Title"] = "Change password"; }
<div class="page-head"><div><h1>Change password</h1><p>Use at least 8 characters.</p></div></div>
<div class="card" style="max-width:480px">
    <div class="card-body">
        <form method="post" asp-action="Password">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3"><label class="form-label">Current password</label><input type="password" name="current" class="form-control" autocomplete="current-password" required /></div>
            <div class="mb-3"><label class="form-label">New password</label><input type="password" name="next" class="form-control" autocomplete="new-password" minlength="8" required /></div>
            <div class="mb-4"><label class="form-label">Confirm new password</label><input type="password" name="confirm" class="form-control" autocomplete="new-password" minlength="8" required /></div>
            <button class="btn btn-primary">Update password</button>
        </form>
    </div>
</div>
